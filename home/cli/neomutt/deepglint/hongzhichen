# vim: filetype=muttrc

unmailboxes *
# personal
set realname    =   "陈鸿志"
set from        =   "hongzhichen@deepglint.com"
set signature   =   $HOME/.config/neomutt/deepglint/signature

# maildir
set folder      =   imaps://imap.exmail.qq.com/
set spoolfile   =   +INBOX
set postponed   =   +Drafts
set trash       =   +Deleted\ Messages
set delete      =   yes
mailboxes +INBOX +其他文件夹/Confluence +其他文件夹/JIRA +其他文件夹/GitLab +Deleted\ Messages +Drafts +Junk +Sent\ Messages

source "cat /run/secrets/mail/deepglint/address | awk '{ print \"set imap_user=\"$1 }' |"
source "cat /run/secrets/mail/deepglint/password | awk '{ print \"set imap_pass=\"$1 }' |"
# smtps
set smtp_url    =   "smtps://$imap_user:$imap_pass@smtp.exmail.qq.com"
set record      =   +INBOX

# address
set alias_file  =   $HOME/.config/neomutt/deepglint/aliases
source  $alias_file

set status_format = "[hongzhichen@deepglint.com%f] %r [Msgs:%?M?%M/?%m%?n? New:%n?%?o? Old:%o?%?d? Del:%d?%?F? Flag:%F?%?t? Tag:%t?%?p? Post:%p?%?b? Inc:%b?%?l? %l?] (%s/%S) %> [%m](%P) "
