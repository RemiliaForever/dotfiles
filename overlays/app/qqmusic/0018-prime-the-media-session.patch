+// MPRIS only exists while the page holds audio focus, and Chromium only grants
+// that for media it considers persistent content, which means longer than five
+// seconds -- anything shorter counts as a UI sound and never reaches the system
+// controls. So the session has to be opened with a real, long enough track.
+// 8 kHz 8-bit mono silence is half a minute for 240 kB and decodes anywhere.
+function silentTrackUrl() {
+  const rate = 8000;
+  const samples = rate * 30;
+  const buffer = new ArrayBuffer(44 + samples);
+  const view = new DataView(buffer);
+
+  const ascii = (at, text) => {
+    for (let i = 0; i < text.length; i++) {
+      view.setUint8(at + i, text.charCodeAt(i));
+    }
+  };
+
+  ascii(0, 'RIFF');
+  view.setUint32(4, 36 + samples, true);
+  ascii(8, 'WAVEfmt ');
+  view.setUint32(16, 16, true);
+  view.setUint16(20, 1, true);
+  view.setUint16(22, 1, true);
+  view.setUint32(24, rate, true);
+  view.setUint32(28, rate, true);
+  view.setUint16(32, 1, true);
+  view.setUint16(34, 8, true);
+  ascii(36, 'data');
+  view.setUint32(40, samples, true);
+  // 8-bit samples are unsigned, so silence is 0x80 and a fresh buffer's 0x00 is
+  // full deflection -- inaudible while it holds, but it clicks on the edges.
+  new Uint8Array(buffer, 44).fill(0x80);
+  return URL.createObjectURL(new Blob([buffer], {
+    type: 'audio/wav'
+  }));
+}
