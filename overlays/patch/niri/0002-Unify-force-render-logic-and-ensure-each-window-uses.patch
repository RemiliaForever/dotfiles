+                    Duration::ZERO
+                };
 
-            if !on_primary && !interval.is_zero() {
-                //fps limited branch
-                let force_render_state = force_render_state_borrow
-                    .entry(surface.id().protocol_id())
-                    .or_default();
+                // Check if the surface should be forced to render
